# =============================================================================
# Bolt Facebook Page Agent Configuration (.env)
# Copy this file to .env (cp .env.example .env) or set these directly in the
# Web Dashboard at http://localhost:5000
# =============================================================================

# Facebook Page credentials (from https://developers.facebook.com/tools/explorer/)
PAGE_ID=
PAGE_TOKEN=
APP_SECRET=
VERIFY_TOKEN=my-secret-verify-token

# Anthropic key (Optional if you only push Exact queued content; required for AI replies & AI Polish)
ANTHROPIC_API_KEY=

# Schedule interval: set POST_EVERY_MINUTES (e.g., 1, 5, 15, 60) OR POST_EVERY_HOURS (e.g., 1, 6, 12)
POST_EVERY_MINUTES=60
POST_EVERY_HOURS=0

# Safety switch: "true" = prints/logs what it would post without publishing; "false" = publishes live to Facebook
DRY_RUN=true

# Port for the local Web Control Panel & Webhook server
PORT=5000
